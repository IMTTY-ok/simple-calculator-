<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/pcAccent</item>
        <item name="colorPrimaryDark">@color/pcBackground</item>
        <item name="colorAccent">@color/pcAccent</item>
        <!-- The window behind the WebView is the app's graphite surface, so
             the app never flashes white between the splash and the first
             frame. -->
        <item name="android:windowBackground">@color/pcBackground</item>
        <item name="android:navigationBarColor">@color/pcBackground</item>
        <item name="android:statusBarColor">@color/pcBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/pcBackground</item>
        <item name="android:navigationBarColor">@color/pcBackground</item>
        <item name="android:statusBarColor">@color/pcBackground</item>
    </style>

    <!-- The launch theme: the branded splash artwork, then the app theme. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/pcBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
