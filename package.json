{
  "name": "calculator",
  "private": true,
  "version": "1.0.0",
  "description": "A premium, tactile calculator PWA with a verified calculation engine, haptics, history and offline support.",
  "license": "MIT",
  "author": "Imtty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMTTY-ok/simple-calculator-.git"
  },
  "keywords": [
    "calculator",
    "pwa",
    "offline-first",
    "react",
    "typescript",
    "haptics",
    "accessible"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test:python": "python -m pytest python -q",
    "test:ui": "python scripts/ui_check.py",
    "test:pwa": "python scripts/pwa_check.py",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "assets": "python scripts/generate_assets.py",
    "signing:key": "python scripts/create_signing_key.py",
    "cap:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run cap:sync && cap build android --androidreleasetype APK",
    "android:aab": "npm run cap:sync && cap build android --androidreleasetype AAB",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3",
    "ejs": "^5.0.2"
  }
}
